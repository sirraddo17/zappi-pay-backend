generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Every admin except the very first one (the account created while
  // setting up the app) can be deactivated — that one is protected
  // in code so a mistake here can never lock everyone out of the
  // admin panel entirely.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  loginCodes   AdminLoginCode[]
}

// One-time email code for admin two-step login.
model AdminLoginCode {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId, createdAt])
}

// A customer's wallet balance lives directly on this record — there's
// only ever one wallet per customer, so a separate Wallet model would
// just be an extra join for no real benefit. WalletTransaction is the
// ledger; this balance is the running total it produces.
model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  username      String?  @unique
  email         String?  @unique
  passwordHash  String
  walletBalance Decimal  @default(0) @db.Decimal(14, 2)
  // Stored as a data: URI (base64-encoded image) rather than a file
  // path — there's no separate file storage set up for this app, so
  // the picture just lives on the row itself. @db.Text since a
  // base64 image comfortably exceeds a normal varchar limit.
  avatarUrl     String?  @db.Text
  active        Boolean  @default(true)
  // Set when an admin issues a temporary password (forgotten-password
  // support). The customer is forced to choose a new password on their
  // next login, and the temporary one stops working after
  // tempPasswordExpiresAt even if never used.
  mustChangePassword    Boolean   @default(false)
  tempPasswordExpiresAt DateTime?
  // 4-digit PIN (bcrypt-hashed) used to confirm purchases/transfers
  // and for quick login on a trusted device. Five wrong tries locks
  // the PIN for 15 minutes; a password login clears the counter.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  // Single pending WebAuthn (fingerprint / Face ID) challenge — only
  // one ceremony per customer is ever in flight, so it lives on the
  // row instead of a separate table.
  webauthnChallenge        String?
  webauthnChallengeExpires DateTime?
  // Referral program: who invited this customer, and when the
  // referrer's one-time bonus was paid (null = not paid yet).
  referredById        String?
  referredBy          Customer?  @relation("Referrals", fields: [referredById], references: [id])
  referrals           Customer[] @relation("Referrals")
  referralBonusPaidAt DateTime?
  referralBonusAmount Decimal?   @db.Decimal(14, 2)
  // Personal bank account number for automatic wallet funding
  // (payment provider "reserved account"). The BVN/NIN used to create
  // it is sent to the provider only — never stored here; kycType just
  // records which one was used.
  bankAccountRef  String?   @unique
  bankAccounts    Json?
  kycType         String?
  bankAccountAt   DateTime?
  // Email alerts for money in/out and new logins (customer can switch
  // off). lastLoginFingerprint spots a login from a new device.
  // Agent / reseller: buys at agent prices (extra admin-set discount)
  // once an admin approves them.
  isAgent             Boolean   @default(false)
  agentRequestedAt    DateTime?
  agentBusinessName   String?
  // Last PIN/password change or login from a new device — large bank
  // transfers soon after are held for admin review (fraud check).
  securityChangedAt   DateTime?
  // Loyalty points balance (earned on purchases, redeemed as wallet credit).
  loyaltyPoints       Int       @default(0)
  emailAlerts          Boolean   @default(true)
  lastLoginFingerprint String?
  // "Delete my account" request; an admin completes it (the ledger is
  // kept, personal details are wiped).
  deletionRequestedAt DateTime?
  deletionReason      String?
  deletedAt           DateTime?
  createdAt     DateTime @default(now())

  walletTransactions WalletTransaction[]
  passwordResetTokens PasswordResetToken[]
  orders             Order[]
  supportTickets     SupportTicket[]
  notifications      Notification[]
  transfersSent      Transfer[]      @relation("TransferSender")
  transfersReceived  Transfer[]      @relation("TransferReceiver")
  airtimeCashRequests AirtimeCashRequest[]
  trustedDevices      TrustedDevice[]
  beneficiaries       Beneficiary[]
  scheduledPurchases  ScheduledPurchase[]
  webauthnCredentials WebAuthnCredential[]
  bankTransfers       BankTransfer[]
  promoRedemptions    PromoRedemption[]
  pushSubscriptions   PushSubscription[]
}

// A browser/phone where the customer turned on quick login. The raw
// device token lives only in that browser's storage; we keep its
// SHA-256 hash, so PIN login only works from a device the customer
// set up themselves (a stranger can't guess PINs from elsewhere).
model TrustedDevice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  webauthnCredentials WebAuthnCredential[]

  @@index([customerId])
}

// A fingerprint / Face ID passkey registered on a trusted device.
model WebAuthnCredential {
  id           String         @id @default(cuid())
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  credentialId String         @unique
  publicKey    Bytes
  counter      Int            @default(0)
  transports   String[]
  createdAt    DateTime       @default(now())
  lastUsedAt   DateTime       @default(now())

  @@index([customerId])
}

enum WalletTxType {
  FUND
  DEBIT
  REFUND
  TRANSFER_OUT
  TRANSFER_IN
  AIRTIME_CASH
  REFERRAL_BONUS
  CASHBACK
  LOYALTY
}

enum WalletTxStatus {
  PENDING
  APPROVED
  REJECTED
}

// V1 funding is manual: a customer submits a transfer reference, an
// admin checks their bank alert and approves it, which is what actually
// credits Customer.walletBalance. reference/note carry whatever proof
// the customer supplied. When automated funding (Paystack etc.) is
// added later, those transactions land here too, just auto-approved by
// the payment webhook instead of an admin.
model WalletTransaction {
  id                 String         @id @default(cuid())
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])
  type               WalletTxType
  amount             Decimal        @db.Decimal(14, 2)
  status             WalletTxStatus @default(PENDING)
  reference          String?
  note               String?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  // Payment provider's transaction reference for automatic bank
  // funding. Unique, so the same payment can never be credited twice
  // (webhook retries, the "check now" button and the webhook racing).
  providerRef        String?        @unique
  createdAt          DateTime       @default(now())

  @@index([customerId, createdAt])
}

enum OrderService {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE
  EDUCATION
  INTERNET
  BETTING
  OTHER
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// One row per VTpass purchase. provider is the network/disco/cable
// operator code VTpass expects; recipient is whichever identifier that
// service needs (phone number, meter number, smartcard number, profile
// ID for education pins). amount is what left the customer's wallet;
// costAmount is what VTpass actually charged us, kept separate so
// margin is visible per order without recomputing it from settings
// that may have changed since.
model Order {
  id              String       @id @default(cuid())
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  service         OrderService
  provider        String
  variationCode   String?
  recipient       String
  recipientName   String?
  amount          Decimal      @db.Decimal(14, 2)
  costAmount      Decimal?     @db.Decimal(14, 2)
  // How much was taken off this order by an admin-set service
  // discount (already subtracted from amount above) — stored per
  // order so the receipt can show "you saved ₦X" even after the
  // discount itself is later changed or removed.
  discountAmount  Decimal?     @db.Decimal(14, 2)
  // Electricity only: "prepaid" / "postpaid" (sent to VTpass as
  // variation_code), kept so "Buy again" can repeat it exactly.
  meterType       String?
  // Promo code used on this order (discount already taken off amount)
  // and any cashback credited back after it succeeded.
  promoCode       String?
  promoDiscount   Decimal?     @db.Decimal(14, 2)
  cashbackAmount  Decimal?     @db.Decimal(14, 2)
  pointsEarned    Int?
  vtpassRequestId String?      @unique
  vtpassStatus    String?
  status          OrderStatus  @default(PENDING)
  responsePayload Json?
  createdAt       DateTime     @default(now())

  supportTickets SupportTicket[]

  @@index([customerId, createdAt])
}

enum TicketStatus {
  OPEN
  RESOLVED
}

// A customer complaint, either general or tied to a specific order
// (via the "Report Issue" button on that order's receipt — orderId
// stays optional so a customer can also raise something with no
// order attached, like a wallet funding problem). Admin resolution
// is tracked here too so both sides see the same status.
model SupportTicket {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id])
  message    String
  status     TicketStatus @default(OPEN)
  // The admin's written answer, sent to the customer as a
  // notification and shown under the ticket in their Profile.
  adminReply String?
  repliedAt  DateTime?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([customerId, createdAt])
}

// A completed wallet-to-wallet transfer between two ZappiPay
// customers, found by phone number or username. Kept as its own
// record (rather than just two WalletTransaction rows) so a
// transfer's sender and receiver can both be looked up directly —
// the matching WalletTransaction rows (TRANSFER_OUT / TRANSFER_IN)
// still get created too, purely so it shows up in each side's
// ordinary transaction history the same way funding or a purchase
// does.
model Transfer {
  id         String   @id @default(cuid())
  senderId   String
  sender     Customer @relation("TransferSender", fields: [senderId], references: [id])
  receiverId String
  receiver   Customer @relation("TransferReceiver", fields: [receiverId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime @default(now())

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

// A single event surfaced to a customer via the notification bell —
// funding approved/rejected, a purchase succeeding or failing, an
// admin wallet adjustment, or a support ticket being resolved. Kept
// deliberately generic (title + message) rather than one model per
// event type, since every trigger just needs to say what happened.
model Notification {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// An admin-composed announcement (info, warning or maintenance
// notice) sent to every active customer at once. Sending one fans
// out into an ordinary Notification row per customer so it shows up
// in the bell like any other event; showBanner additionally pins it
// as a strip on the customer dashboard until an admin ends it
// (active = false). recipientCount is kept for the admin's own
// record of how many customers it reached.
model Broadcast {
  id               String    @id @default(cuid())
  title            String
  message          String
  type             String    @default("INFO")
  showBanner       Boolean   @default(false)
  active           Boolean   @default(true)
  recipientCount   Int       @default(0)
  createdByAdminId String?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())

  @@index([active, createdAt])
}

enum AirtimeCashStatus {
  PENDING
  APPROVED
  REJECTED
}

// A customer asking to turn airtime back into wallet cash (usually
// airtime bought by mistake). VTpass has no reversal, so this is a
// manual queue: the customer transfers the airtime to the business
// line for that network (Settings.airtimeToCashNumbers), then an
// admin confirms it arrived and approves, which credits payoutAmount
// to the wallet. feePercent is copied from Settings at request time
// so a later fee change never alters what this customer was quoted.
// receivedAmount is what the admin actually saw arrive — it can be
// less than amount, in which case payout is recomputed from it.
model AirtimeCashRequest {
  id                String            @id @default(cuid())
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  network           String
  senderPhone       String
  amount            Decimal           @db.Decimal(14, 2)
  feePercent        Decimal           @db.Decimal(5, 2)
  payoutAmount      Decimal           @db.Decimal(14, 2)
  receivedAmount    Decimal?          @db.Decimal(14, 2)
  orderId           String?
  note              String?
  status            AirtimeCashStatus @default(PENDING)
  adminNote         String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

// One-time "forgot password" email link. Only a SHA-256 hash of the
// token is stored, so a database leak can't be used to reset anyone's
// password; the raw token only ever exists in the email itself.
model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

// Single row, holds the live VTpass credentials and pricing knobs so
// they're editable from the admin panel rather than redeploying.
// vtpassMode gates which VTpass base URL requests use — stays on
// "sandbox" until the live merchant agreement with VTpass is finalized.
model Settings {
  id              String   @id @default(cuid())
  vtpassMode      String   @default("sandbox")
  vtpassApiKey    String?
  vtpassSecretKey String?
  vtpassPublicKey String?
  // Per-service markup, e.g. { "AIRTIME": 2, "DATA": 3 } — percent
  // added on top of VTpass's own price for that service. A service
  // missing from the map (or the whole map being empty) falls back to
  // 0% for that service, computed in the purchase route in
  // vtpass.routes.js rather than stored redundantly here.
  markupPercentByService Json    @default("{}")
  // Per-service discount, e.g. { "DATA": 5 } — percent taken OFF the
  // marked-up price, applied automatically to every purchase of that
  // service. Same shape and fallback as markup (missing = 0%). Shown
  // to customers on the dashboard tiles and in the Buy flow via the
  // public GET /pricing route.
  discountPercentByService Json  @default("{}")
  // Enforced server-side (not just as a frontend hint) in the
  // fund-request and purchase routes, so a request can't bypass
  // the configured floor just by calling the API directly.
  minFundingAmount  Decimal  @default(100) @db.Decimal(14, 2)
  minPurchaseAmount Decimal  @default(50) @db.Decimal(14, 2)
  // Airtime-to-Cash: off until an admin turns it on and fills in the
  // receiving line per network, e.g. { "mtn": "0803...", "glo": "..." }
  // (keys are VTpass airtime serviceIDs). Fee is the percent kept
  // from the airtime value; the rest is credited to the wallet.
  airtimeToCashEnabled    Boolean @default(false)
  airtimeToCashFeePercent Decimal @default(20) @db.Decimal(5, 2)
  airtimeToCashMinAmount  Decimal @default(500) @db.Decimal(14, 2)
  airtimeToCashNumbers    Json    @default("{}")
  // Referral program: fixed bonus paid to the referrer once, when the
  // person they invited completes a first successful purchase of at
  // least referralMinPurchase.
  referralEnabled     Boolean @default(false)
  referralBonusAmount Decimal @default(100) @db.Decimal(14, 2)
  referralMinPurchase Decimal @default(500) @db.Decimal(14, 2)
  // Fee kept from automatic bank-transfer funding: percent of the
  // amount, capped at bankFundingFeeCap (0 = no cap). Both 0 = free.
  bankFundingFeePercent Decimal @default(0) @db.Decimal(5, 2)
  bankFundingFeeCap     Decimal @default(0) @db.Decimal(14, 2)
  // Monnify keys set from Admin → Settings. When the API key here is
  // empty, the MONNIFY_* environment variables on Render are used.
  monnifyMode         String  @default("sandbox")
  monnifyApiKey       String?
  monnifySecretKey    String?
  monnifyContractCode String?
  // Send to Bank (Monnify disbursement). Off until an admin turns it on.
  // monnifyWalletAccount is the Monnify wallet account number money is
  // sent from. Fee is a flat ₦ amount the customer pays per transfer.
  monnifyWalletAccount  String?
  bankTransferEnabled   Boolean @default(false)
  bankTransferFee       Decimal @default(0) @db.Decimal(14, 2)
  bankTransferMin       Decimal @default(100) @db.Decimal(14, 2)
  bankTransferMax       Decimal @default(50000) @db.Decimal(14, 2)
  bankTransferDailyMax  Decimal @default(200000) @db.Decimal(14, 2)
  // Email alerts (off until Resend is set up and an admin turns it on).
  emailAlertsEnabled    Boolean @default(false)
  // Daily spending limits by verification level (verified = has done
  // BVN/NIN). Covers purchases, ZappiPay transfers and bank transfers.
  kycLimitsEnabled      Boolean @default(false)
  dailyLimitUnverified  Decimal @default(50000) @db.Decimal(14, 2)
  dailyLimitVerified    Decimal @default(1000000) @db.Decimal(14, 2)
  // Cashback per service, e.g. { "DATA": 1 } = 1% back, capped per order.
  cashbackEnabled          Boolean @default(false)
  cashbackPercentByService Json    @default("{}")
  cashbackMaxPerOrder      Decimal @default(500) @db.Decimal(14, 2)
  supportWhatsapp          String?
  // Business bank account shown to customers for manual funding
  // (they transfer, then submit the reference for admin approval).
  // Fraud check: hold bank transfers of at least fraudHoldAmount made
  // within fraudHoldHours of signup or a PIN/password/new-device change.
  fraudHoldEnabled         Boolean @default(true)
  fraudHoldAmount          Decimal @default(20000) @db.Decimal(14, 2)
  fraudHoldHours           Int     @default(24)
  // Email code on every admin login (needs Resend email set up).
  adminTwoFactorEnabled    Boolean @default(false)
  // Morning summary email to admins at 7am.
  dailySummaryEnabled      Boolean @default(false)
  lastDailySummaryDate     String?
  // Push notifications: keys generated automatically on first use.
  vapidPublicKey           String?
  vapidPrivateKey          String?
  // Loyalty: earn loyaltyPointsPer100 points per ₦100 spent on
  // purchases; each point is worth loyaltyPointValue ₦ when redeemed
  // (minimum loyaltyMinRedeem points).
  loyaltyEnabled           Boolean @default(false)
  loyaltyPointsPer100      Decimal @default(1) @db.Decimal(8, 2)
  loyaltyPointValue        Decimal @default(0.5) @db.Decimal(8, 2)
  loyaltyMinRedeem         Int     @default(200)
  manualFundingEnabled     Boolean @default(true)
  manualBankName           String?
  manualAccountNumber      String?
  manualAccountName        String?
  // Agent pricing: extra % off per service for approved agents, on top
  // of any normal discount, e.g. { "DATA": 3, "AIRTIME": 2 }.
  agentPricingEnabled          Boolean @default(false)
  agentDiscountPercentByService Json   @default("{}")
  updatedAt              DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorAdminId String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// A saved phone number / meter / smartcard / account ID, so customers
// tap instead of retyping (fewer wrong-number purchases).
model Beneficiary {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service     OrderService
  serviceID   String
  billersCode String
  meterType   String?
  nickname    String?
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime     @default(now())

  @@unique([customerId, service, serviceID, billersCode])
  @@index([customerId, lastUsedAt])
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// A purchase that repeats automatically (e.g. renew DStv monthly). It
// was PIN-confirmed when created; each run is a normal purchase from
// the wallet (lib/schedules.js). Paused after 3 failures in a row.
model ScheduledPurchase {
  id            String            @id @default(cuid())
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       OrderService
  serviceID     String
  variationCode String?
  meterType     String?
  billersCode   String
  phone         String
  // Base (VTpass) amount for amount-based services; null for plans,
  // whose current price is looked up at each run.
  amount        Decimal?          @db.Decimal(14, 2)
  frequency     ScheduleFrequency
  anchorDay     Int
  nickname      String?
  active        Boolean           @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  lastStatus    String?
  lastError     String?
  failCount     Int               @default(0)
  createdAt     DateTime          @default(now())

  @@index([active, nextRunAt])
  @@index([customerId])
}

// A customer's transfer from their wallet to a bank account (Monnify
// disbursement). The wallet is debited (amount + fee) before Monnify is
// called; a FAILED / REVERSED / EXPIRED result refunds it exactly once.
// Status: PROCESSING | PENDING_AUTHORIZATION | SUCCESS | FAILED | REVERSED
model BankTransfer {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  amount         Decimal   @db.Decimal(14, 2)
  fee            Decimal   @default(0) @db.Decimal(14, 2)
  bankCode       String
  bankName       String?
  accountNumber  String
  accountName    String
  narration      String?
  reference      String    @unique
  status         String    @default("PROCESSING")
  providerStatus String?
  failureReason  String?
  refundedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

// Discount codes customers type at checkout, e.g. FIRST50.
// type PERCENT (value = %, capped by maxDiscount) or FLAT (value = ₦).
model PromoCode {
  id               String            @id @default(cuid())
  code             String            @unique
  description      String?
  type             String            @default("FLAT")
  value            Decimal           @db.Decimal(14, 2)
  maxDiscount      Decimal?          @db.Decimal(14, 2)
  minAmount        Decimal           @default(0) @db.Decimal(14, 2)
  services         String[]
  usageLimit       Int?
  perCustomerLimit Int               @default(1)
  usedCount        Int               @default(0)
  newCustomersOnly Boolean           @default(false)
  active           Boolean           @default(true)
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  redemptions      PromoRedemption[]
}

model PromoRedemption {
  id         String    @id @default(cuid())
  promoId    String
  promo      PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String    @unique
  discount   Decimal   @db.Decimal(14, 2)
  createdAt  DateTime  @default(now())

  @@index([promoId, customerId])
}

// Admin-posted notices, e.g. "MTN data is slow right now". service
// null = shown everywhere; level INFO or WARNING.
model ServiceNotice {
  id        String    @id @default(cuid())
  message   String
  service   String?
  level     String    @default("INFO")
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// A browser/phone that allowed push notifications.
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}
