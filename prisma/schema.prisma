generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Every admin except the very first one (the account created while
  // setting up the app) can be deactivated — that one is protected
  // in code so a mistake here can never lock everyone out of the
  // admin panel entirely.
  active       Boolean  @default(true)
  // OWNER = full access. SUPPORT = customer care only: can look up
  // customers, check identity, answer tickets and re-check orders, but
  // money, passwords and settings go to an OWNER as an Escalation.
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())
  loginCodes   AdminLoginCode[]
}

// A support staff request that needs an owner's approval (password
// reset, refund, wallet correction...). The customer is told it was
// escalated and when to expect an answer (dueAt).
model Escalation {
  id             String    @id @default(cuid())
  ref            String    @unique
  type           String
  status         String    @default("PENDING") // PENDING, PROCESSING, APPROVED, REJECTED
  customerId     String
  orderId        String?
  transferId     String?
  amount         Decimal?  @db.Decimal(14, 2)
  reason         String
  checks         Json      @default("{}")
  createdById    String
  createdByName  String
  reviewedById   String?
  reviewedByName String?
  reviewNote     String?
  result         String?
  dueAt          DateTime
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([customerId])
}

// One-time email code for admin two-step login.
model AdminLoginCode {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId, createdAt])
}

// One-time backup codes for admin two-step login, for when the email
// code can't be sent. Only hashes are stored.
model AdminBackupCode {
  id        String    @id @default(cuid())
  adminId   String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// A customer's wallet balance lives directly on this record — there's
// only ever one wallet per customer, so a separate Wallet model would
// just be an extra join for no real benefit. WalletTransaction is the
// ledger; this balance is the running total it produces.
model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  username      String?  @unique
  email         String?  @unique
  passwordHash  String
  walletBalance Decimal  @default(0) @db.Decimal(14, 2)
  // Savings pocket (off until the owner turns it on in Settings).
  // savingsLowBalance is the lowest the pocket has been since the last
  // interest run, so money moved in just before the run and out after
  // it earns nothing.
  savingsBalance    Decimal @default(0) @db.Decimal(14, 2)
  savingsLowBalance Decimal @default(0) @db.Decimal(14, 2)
  savingsEarned     Decimal @default(0) @db.Decimal(14, 2)
  // Wrong-password lock: 5 wrong tries → locked for 15 minutes.
  loginFailedAttempts Int       @default(0)
  loginLockedUntil    DateTime?
  // "Log out all other devices": tokens issued before this are refused.
  tokensValidAfter    DateTime?
  // Stored as a data: URI (base64-encoded image) rather than a file
  // path — there's no separate file storage set up for this app, so
  // the picture just lives on the row itself. @db.Text since a
  // base64 image comfortably exceeds a normal varchar limit.
  avatarUrl     String?  @db.Text
  active        Boolean  @default(true)
  // Set when an admin issues a temporary password (forgotten-password
  // support). The customer is forced to choose a new password on their
  // next login, and the temporary one stops working after
  // tempPasswordExpiresAt even if never used.
  mustChangePassword    Boolean   @default(false)
  tempPasswordExpiresAt DateTime?
  // 4-digit PIN (bcrypt-hashed) used to confirm purchases/transfers
  // and for quick login on a trusted device. Five wrong tries locks
  // the PIN for 15 minutes; a password login clears the counter.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  // Single pending WebAuthn (fingerprint / Face ID) challenge — only
  // one ceremony per customer is ever in flight, so it lives on the
  // row instead of a separate table.
  webauthnChallenge        String?
  webauthnChallengeExpires DateTime?
  // Referral program: who invited this customer, and when the
  // referrer's one-time bonus was paid (null = not paid yet).
  referredById        String?
  referredBy          Customer?  @relation("Referrals", fields: [referredById], references: [id])
  referrals           Customer[] @relation("Referrals")
  referralBonusPaidAt DateTime?
  referralBonusAmount Decimal?   @db.Decimal(14, 2)
  // Personal bank account number for automatic wallet funding
  // (payment provider "reserved account"). The BVN/NIN used to create
  // it is sent to the provider only — never stored here; kycType just
  // records which one was used.
  bankAccountRef  String?   @unique
  bankAccounts    Json?
  kycType         String?
  // Keyed hash of the BVN/NIN used (never the number itself), so one
  // identity can only verify one ZAPPI PAY account.
  kycHash         String?   @unique
  bankAccountAt   DateTime?
  // Email alerts for money in/out and new logins (customer can switch
  // off). lastLoginFingerprint spots a login from a new device.
  // Agent / reseller: buys at agent prices (extra admin-set discount)
  // once an admin approves them.
  isAgent             Boolean   @default(false)
  agentRequestedAt    DateTime?
  agentBusinessName   String?
  agentShopAddress    String?
  agentRejectedAt     DateTime?
  agentRejectReason   String?
  // Agent shop link (/shop/<username>): customers who buy through it
  // earn the agent a commission.
  shopEnabled         Boolean   @default(false)
  shopTagline         String?
  shopShowWhatsapp    Boolean   @default(false)
  // Identity checks for support: date of birth (set once at signup,
  // only support can clear it) and a security question whose answer
  // is stored bcrypt-hashed like a password.
  dateOfBirth         DateTime? @db.Date
  securityQuestion    String?
  securityAnswerHash  String?
  // Last PIN/password change or login from a new device — large bank
  // transfers soon after are held for admin review (fraud check).
  securityChangedAt   DateTime?
  // Loyalty points balance (earned on purchases, redeemed as wallet credit).
  loyaltyPoints       Int       @default(0)
  emailAlerts          Boolean   @default(true)
  lastLoginFingerprint String?
  // Scrambled network/device fingerprints (never the raw IP) to spot
  // one person creating many accounts.
  signupIpHash         String?
  signupDeviceHash     String?
  lastIpHash           String?
  // "Delete my account" request; an admin completes it (the ledger is
  // kept, personal details are wiped).
  deletionRequestedAt DateTime?
  deletionReason      String?
  deletedAt           DateTime?
  // Customer turned off "your DStv expires soon" style reminders.
  billRemindersOff    Boolean  @default(false)
  // Customer froze their own account (e.g. lost phone). Support checks
  // who they are before switching it back on.
  selfFrozenAt        DateTime?
  // Name and date of birth confirmed against BVN/NIN (then locked).
  kycVerifiedAt       DateTime?
  // App language chosen in Profile (en, pcm, yo, ha, ig) — broadcasts
  // are translated into it when AI translation is on.
  language            String?
  createdAt     DateTime @default(now())

  walletTransactions WalletTransaction[]
  passwordResetTokens PasswordResetToken[]
  orders             Order[]
  pinBatches         PinBatch[]
  loginSessions      LoginSession[]
  supportTickets     SupportTicket[]
  notifications      Notification[]
  transfersSent      Transfer[]      @relation("TransferSender")
  transfersReceived  Transfer[]      @relation("TransferReceiver")
  airtimeCashRequests AirtimeCashRequest[]
  trustedDevices      TrustedDevice[]
  beneficiaries       Beneficiary[]
  scheduledPurchases  ScheduledPurchase[]
  webauthnCredentials WebAuthnCredential[]
  bankTransfers       BankTransfer[]
  promoRedemptions    PromoRedemption[]
  pushSubscriptions   PushSubscription[]
}

// A browser/phone where the customer turned on quick login. The raw
// device token lives only in that browser's storage; we keep its
// SHA-256 hash, so PIN login only works from a device the customer
// set up themselves (a stranger can't guess PINs from elsewhere).
model TrustedDevice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  webauthnCredentials WebAuthnCredential[]

  @@index([customerId])
}

// A fingerprint / Face ID passkey registered on a trusted device.
model WebAuthnCredential {
  id           String         @id @default(cuid())
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  credentialId String         @unique
  publicKey    Bytes
  counter      Int            @default(0)
  transports   String[]
  createdAt    DateTime       @default(now())
  lastUsedAt   DateTime       @default(now())

  @@index([customerId])
}

enum WalletTxType {
  FUND
  DEBIT
  REFUND
  TRANSFER_OUT
  TRANSFER_IN
  AIRTIME_CASH
  REFERRAL_BONUS
  CASHBACK
  LOYALTY
  CONTEST_PRIZE
  COUPON
  SAVINGS_IN
  SAVINGS_OUT
  INTEREST
  CHALLENGE_REWARD
  DELIVERY_BONUS
  SHOP_COMMISSION
}

enum WalletTxStatus {
  PENDING
  APPROVED
  REJECTED
}

// V1 funding is manual: a customer submits a transfer reference, an
// admin checks their bank alert and approves it, which is what actually
// credits Customer.walletBalance. reference/note carry whatever proof
// the customer supplied. When automated funding (Paystack etc.) is
// added later, those transactions land here too, just auto-approved by
// the payment webhook instead of an admin.
model WalletTransaction {
  id                 String         @id @default(cuid())
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])
  type               WalletTxType
  amount             Decimal        @db.Decimal(14, 2)
  status             WalletTxStatus @default(PENDING)
  reference          String?
  note               String?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  // Payment provider's transaction reference for automatic bank
  // funding. Unique, so the same payment can never be credited twice
  // (webhook retries, the "check now" button and the webhook racing).
  providerRef        String?        @unique
  createdAt          DateTime       @default(now())

  @@index([customerId, createdAt])
}

enum OrderService {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE
  EDUCATION
  INTERNET
  BETTING
  INTERNATIONAL
  INSURANCE
  OTHER
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// One row per VTpass purchase. provider is the network/disco/cable
// operator code VTpass expects; recipient is whichever identifier that
// service needs (phone number, meter number, smartcard number, profile
// ID for education pins). amount is what left the customer's wallet;
// costAmount is what VTpass actually charged us, kept separate so
// margin is visible per order without recomputing it from settings
// that may have changed since.
model Order {
  id              String       @id @default(cuid())
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  service         OrderService
  provider        String
  variationCode   String?
  recipient       String
  recipientName   String?
  amount          Decimal      @db.Decimal(14, 2)
  costAmount      Decimal?     @db.Decimal(14, 2)
  // How much was taken off this order by an admin-set service
  // discount (already subtracted from amount above) — stored per
  // order so the receipt can show "you saved ₦X" even after the
  // discount itself is later changed or removed.
  discountAmount  Decimal?     @db.Decimal(14, 2)
  // Electricity only: "prepaid" / "postpaid" (sent to VTpass as
  // variation_code), kept so "Buy again" can repeat it exactly.
  meterType       String?
  // Exam PINs bought in bulk (e.g. 20 WAEC result checkers in one order).
  quantity        Int?
  // Promo code used on this order (discount already taken off amount)
  // and any cashback credited back after it succeeded.
  promoCode       String?
  promoDiscount   Decimal?     @db.Decimal(14, 2)
  cashbackAmount  Decimal?     @db.Decimal(14, 2)
  pointsEarned    Int?
  // Bought through an agent's shop link: the agent and their commission.
  shopAgentId     String?
  shopCommission  Decimal?     @db.Decimal(14, 2)
  vtpassRequestId String?      @unique
  vtpassStatus    String?
  status          OrderStatus  @default(PENDING)
  responsePayload Json?
  // Last time the order was reported to VTpass support by email.
  vtpassEscalatedAt  DateTime?
  createdAt       DateTime     @default(now())

  supportTickets SupportTicket[]

  @@index([customerId, createdAt])
  @@index([shopAgentId, createdAt])
}

enum TicketStatus {
  OPEN
  RESOLVED
}

// A customer complaint, either general or tied to a specific order
// (via the "Report Issue" button on that order's receipt — orderId
// stays optional so a customer can also raise something with no
// order attached, like a wallet funding problem). Admin resolution
// is tracked here too so both sides see the same status.
model SupportTicket {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id])
  message    String
  status     TicketStatus @default(OPEN)
  // The admin's written answer, sent to the customer as a
  // notification and shown under the ticket in their Profile.
  adminReply String?
  repliedAt  DateTime?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  attachments TicketAttachment[]

  @@index([customerId, createdAt])
}

// A completed wallet-to-wallet transfer between two ZappiPay
// customers, found by phone number or username. Kept as its own
// record (rather than just two WalletTransaction rows) so a
// transfer's sender and receiver can both be looked up directly —
// the matching WalletTransaction rows (TRANSFER_OUT / TRANSFER_IN)
// still get created too, purely so it shows up in each side's
// ordinary transaction history the same way funding or a purchase
// does.
model Transfer {
  id         String   @id @default(cuid())
  senderId   String
  sender     Customer @relation("TransferSender", fields: [senderId], references: [id])
  receiverId String
  receiver   Customer @relation("TransferReceiver", fields: [receiverId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime @default(now())

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

// A single event surfaced to a customer via the notification bell —
// funding approved/rejected, a purchase succeeding or failing, an
// admin wallet adjustment, or a support ticket being resolved. Kept
// deliberately generic (title + message) rather than one model per
// event type, since every trigger just needs to say what happened.
model Notification {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  title      String
  message    String
  // TRANSACTION (money in/out) / ACCOUNT (security, family, support) /
  // UPDATE (announcements, promos, reminders) — the Notifications tabs.
  category   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// An admin-composed announcement (info, warning or maintenance
// notice) sent to every active customer at once. Sending one fans
// out into an ordinary Notification row per customer so it shows up
// in the bell like any other event; showBanner additionally pins it
// as a strip on the customer dashboard until an admin ends it
// (active = false). recipientCount is kept for the admin's own
// record of how many customers it reached.
model Broadcast {
  id               String    @id @default(cuid())
  title            String
  message          String
  type             String    @default("INFO")
  showBanner       Boolean   @default(false)
  active           Boolean   @default(true)
  recipientCount   Int       @default(0)
  createdByAdminId String?
  endedAt          DateTime?
  // Who it went to (lib/audience.js): ALL, AGENTS, NEW_7, NEVER_BOUGHT,
  // ACTIVE_30, INACTIVE_30.
  audience         String    @default("ALL")
  createdAt        DateTime  @default(now())

  @@index([active, createdAt])
}

enum AirtimeCashStatus {
  PENDING
  APPROVED
  REJECTED
}

// A customer asking to turn airtime back into wallet cash (usually
// airtime bought by mistake). VTpass has no reversal, so this is a
// manual queue: the customer transfers the airtime to the business
// line for that network (Settings.airtimeToCashNumbers), then an
// admin confirms it arrived and approves, which credits payoutAmount
// to the wallet. feePercent is copied from Settings at request time
// so a later fee change never alters what this customer was quoted.
// receivedAmount is what the admin actually saw arrive — it can be
// less than amount, in which case payout is recomputed from it.
model AirtimeCashRequest {
  id                String            @id @default(cuid())
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  network           String
  senderPhone       String
  amount            Decimal           @db.Decimal(14, 2)
  feePercent        Decimal           @db.Decimal(5, 2)
  payoutAmount      Decimal           @db.Decimal(14, 2)
  receivedAmount    Decimal?          @db.Decimal(14, 2)
  orderId           String?
  note              String?
  status            AirtimeCashStatus @default(PENDING)
  adminNote         String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

// One-time "forgot password" email link. Only a SHA-256 hash of the
// token is stored, so a database leak can't be used to reset anyone's
// password; the raw token only ever exists in the email itself.
model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

// Single row, holds the live VTpass credentials and pricing knobs so
// they're editable from the admin panel rather than redeploying.
// vtpassMode gates which VTpass base URL requests use — stays on
// "sandbox" until the live merchant agreement with VTpass is finalized.
model Settings {
  id              String   @id @default(cuid())
  vtpassMode      String   @default("sandbox")
  vtpassApiKey    String?
  vtpassSecretKey String?
  vtpassPublicKey String?
  // Per-service markup, e.g. { "AIRTIME": 2, "DATA": 3 } — percent
  // added on top of VTpass's own price for that service. A service
  // missing from the map (or the whole map being empty) falls back to
  // 0% for that service, computed in the purchase route in
  // vtpass.routes.js rather than stored redundantly here.
  markupPercentByService Json    @default("{}")
  // Most markup (₦) added to one purchase, e.g. { "CABLE": 100 } —
  // 1% but never more than ₦100. Missing/0 = no maximum.
  markupCapByService     Json    @default("{}")
  // Per-service discount, e.g. { "DATA": 5 } — percent taken OFF the
  // marked-up price, applied automatically to every purchase of that
  // service. Same shape and fallback as markup (missing = 0%). Shown
  // to customers on the dashboard tiles and in the Buy flow via the
  // public GET /pricing route.
  discountPercentByService Json  @default("{}")
  // Enforced server-side (not just as a frontend hint) in the
  // fund-request and purchase routes, so a request can't bypass
  // the configured floor just by calling the API directly.
  minFundingAmount  Decimal  @default(100) @db.Decimal(14, 2)
  minPurchaseAmount Decimal  @default(50) @db.Decimal(14, 2)
  // Airtime-to-Cash: off until an admin turns it on and fills in the
  // receiving line per network, e.g. { "mtn": "0803...", "glo": "..." }
  // (keys are VTpass airtime serviceIDs). Fee is the percent kept
  // from the airtime value; the rest is credited to the wallet.
  airtimeToCashEnabled    Boolean @default(false)
  airtimeToCashFeePercent Decimal @default(20) @db.Decimal(5, 2)
  airtimeToCashMinAmount  Decimal @default(500) @db.Decimal(14, 2)
  airtimeToCashNumbers    Json    @default("{}")
  // Referral program: fixed bonus paid to the referrer once, when the
  // person they invited completes a first successful purchase of at
  // least referralMinPurchase.
  referralEnabled     Boolean @default(false)
  referralBonusAmount Decimal @default(100) @db.Decimal(14, 2)
  referralMinPurchase Decimal @default(500) @db.Decimal(14, 2)
  // Fee kept from automatic bank-transfer funding: percent of the
  // amount, capped at bankFundingFeeCap (0 = no cap). Both 0 = free.
  bankFundingFeePercent Decimal @default(0) @db.Decimal(5, 2)
  bankFundingFeeCap     Decimal @default(0) @db.Decimal(14, 2)
  // Monnify keys set from Admin → Settings. When the API key here is
  // empty, the MONNIFY_* environment variables on Render are used.
  monnifyMode         String  @default("sandbox")
  monnifyApiKey       String?
  monnifySecretKey    String?
  monnifyContractCode String?
  // Send to Bank (Monnify disbursement). Off until an admin turns it on.
  // monnifyWalletAccount is the Monnify wallet account number money is
  // sent from. Fee is a flat ₦ amount the customer pays per transfer.
  monnifyWalletAccount  String?
  bankTransferEnabled   Boolean @default(false)
  bankTransferFee       Decimal @default(0) @db.Decimal(14, 2)
  // Fee by amount, matching Monnify's own bands. Empty = same as
  // bankTransferFee. Mid = ₦10,000–₦49,999.99, High = ₦50,000 and above.
  bankTransferFeeMid    Decimal? @db.Decimal(14, 2)
  bankTransferFeeHigh   Decimal? @db.Decimal(14, 2)
  bankTransferMin       Decimal @default(100) @db.Decimal(14, 2)
  bankTransferMax       Decimal @default(50000) @db.Decimal(14, 2)
  bankTransferDailyMax  Decimal @default(200000) @db.Decimal(14, 2)
  // Email alerts (off until Resend is set up and an admin turns it on).
  emailAlertsEnabled    Boolean @default(false)
  // Daily spending limits by verification level (verified = has done
  // BVN/NIN). Covers purchases, ZappiPay transfers and bank transfers.
  kycLimitsEnabled      Boolean @default(false)
  dailyLimitUnverified  Decimal @default(50000) @db.Decimal(14, 2)
  dailyLimitVerified    Decimal @default(1000000) @db.Decimal(14, 2)
  // Cashback per service, e.g. { "DATA": 1 } = 1% back, capped per order.
  cashbackEnabled          Boolean @default(false)
  cashbackPercentByService Json    @default("{}")
  cashbackMaxPerOrder      Decimal @default(500) @db.Decimal(14, 2)
  supportWhatsapp          String?
  // Business bank account shown to customers for manual funding
  // (they transfer, then submit the reference for admin approval).
  // Fraud check: hold bank transfers of at least fraudHoldAmount made
  // within fraudHoldHours of signup or a PIN/password/new-device change.
  fraudHoldEnabled         Boolean @default(true)
  fraudHoldAmount          Decimal @default(20000) @db.Decimal(14, 2)
  fraudHoldHours           Int     @default(24)
  // Email code on every admin login (needs Resend email set up).
  adminTwoFactorEnabled    Boolean @default(false)
  // Morning summary email to admins at 7am.
  dailySummaryEnabled      Boolean @default(false)
  lastDailySummaryDate     String?
  // Push notifications: keys generated automatically on first use.
  vapidPublicKey           String?
  vapidPrivateKey          String?
  // Loyalty: earn loyaltyPointsPer100 points per ₦100 spent on
  // purchases; each point is worth loyaltyPointValue ₦ when redeemed
  // (minimum loyaltyMinRedeem points).
  loyaltyEnabled           Boolean @default(false)
  loyaltyPointsPer100      Decimal @default(1) @db.Decimal(8, 2)
  loyaltyPointValue        Decimal @default(0.5) @db.Decimal(8, 2)
  loyaltyMinRedeem         Int     @default(200)
  manualFundingEnabled     Boolean @default(true)
  manualBankName           String?
  manualAccountNumber      String?
  manualAccountName        String?
  // Several business accounts for manual funding, each with its own
  // on/off switch: [{ id, bankName, accountNumber, accountName, enabled }].
  manualAccounts           Json    @default("[]")
  // Automatic-funding banks (e.g. "Wema bank") hidden from customers
  // while that bank is having network problems.
  hiddenFundingBanks       Json    @default("[]")
  // Agent pricing: extra % off per service for approved agents, on top
  // of any normal discount, e.g. { "DATA": 3, "AIRTIME": 2 }.
  agentPricingEnabled          Boolean @default(false)
  agentDiscountPercentByService Json   @default("{}")
  // AI assistant (Claude API). The key is never sent back to the
  // browser. Spending stops for the month once aiMonthlyBudgetUsd of
  // estimated usage is reached.
  aiApiKey                 String?
  aiCustomerEnabled        Boolean @default(false)
  // Let the customer assistant prepare purchases (paid with PIN).
  aiChatBuyEnabled         Boolean @default(true)
  // AI-written morning briefing on top of the daily summary, and AI
  // translation of broadcasts into each customer's app language.
  aiBriefingEnabled        Boolean @default(true)
  aiTranslateBroadcasts    Boolean @default(true)
  aiAdminEnabled           Boolean @default(false)
  aiCustomerModel          String  @default("claude-haiku-4-5")
  aiAdminModel             String  @default("claude-sonnet-5")
  aiCustomerDailyLimit     Int     @default(20)
  aiMonthlyBudgetUsd       Decimal @default(10) @db.Decimal(10, 2)
  // Voice notes (lib/voice.js). The phone's own speech recognition is
  // always available; this switches on the better OpenAI transcription.
  voiceAiEnabled           Boolean @default(false)
  openaiApiKey             String?
  voiceMonthlyBudgetUsd    Decimal @default(5) @db.Decimal(10, 2)
  voiceDailyLimit          Int     @default(20)
  // Recharge card printing (ClubKonnect / Nellobytes e-PINs). The key
  // never goes back to the browser. Discounts are % off the card value;
  // the supplier discount is what ClubKonnect gives us (for profit).
  ckEnabled                Boolean @default(false)
  ckUserId                 String?
  ckApiKey                 String?
  epinCustomerDiscountPct  Decimal @default(0) @db.Decimal(5, 2)
  epinAgentDiscountPct     Decimal @default(2) @db.Decimal(5, 2)
  epinSupplierDiscountPct  Decimal @default(5) @db.Decimal(5, 2)
  epinDailyCards           Int     @default(300)
  // Who handles Bet Funding: VTPASS or CLUBKONNECT.
  bettingSupplier          String  @default("VTPASS")
  // Video adverts in the app (off = pictures only).
  videoAdsEnabled          Boolean @default(false)
  // HeyGen AI presenter videos (optional; key never sent to the browser).
  // Receipts carry the sender's invite link + QR (Settings → Referrals).
  receiptInviteEnabled     Boolean @default(true)
  receiptInviteMessage     String?
  heygenEnabled            Boolean @default(false)
  heygenApiKey             String?
  heygenMonthlyBudgetUsd   Decimal @default(10) @db.Decimal(8, 2)
  heygenPricePerMinUsd     Decimal @default(1) @db.Decimal(6, 2)
  heygenAvatarId           String?
  heygenVoiceId            String?
  // Admin alerts for things waiting on you (new support message, OTP
  // needed, funding request...), by push to the admin app and email.
  adminAlertPush           Boolean @default(true)
  adminAlertEmail          Boolean @default(true)
  // After a successful purchase, ask how it went and invite happy
  // customers to share their referral link.
  feedbackPromptEnabled    Boolean @default(true)
  // Safety limit: discounts + promo + cashback + loyalty on one purchase
  // may use at most this % of what we earn on it (lib/rewardGuard.js).
  rewardGuardEnabled       Boolean @default(true)
  rewardGuardPercent       Int     @default(50)
  // Savings with daily interest (lib/savings.js). Off by default and
  // can only be turned on once savingsPartnerNote says which licence or
  // licensed partner it runs under.
  savingsEnabled           Boolean @default(false)
  savingsRatePct           Decimal @default(10) @db.Decimal(5, 2)
  savingsMinBalance        Int     @default(1000)
  savingsMaxBalance        Int     @default(500000)
  savingsDailyBudget       Int     @default(5000)
  savingsPartnerNote       String?
  savingsLastRunDate       String?
  // Maintenance: pause every purchase, or just some services, with a
  // message for customers (lib/maintenance.js). Scheduled top-ups wait
  // and run once it's switched back on.
  purchasesPaused          Boolean @default(false)
  pausedServices           Json    @default("[]")
  maintenanceMessage       String?
  // Email owners when the server crashes or VTpass keeps failing.
  errorAlertsEnabled       Boolean @default(true)
  // Hours an escalated request should be answered in (told to the
  // customer), and where "Report to VTpass" emails go.
  escalationHours          Int     @default(24)
  vtpassSupportEmail       String?
  // "Delivered in 60 seconds or ₦20 back" (lib/deliveryPromise.js).
  deliveryPromiseEnabled   Boolean @default(false)
  deliveryPromiseSeconds   Int     @default(60)
  deliveryPromiseBonus     Int     @default(20)
  deliveryPromiseMinAmount Int     @default(100)
  deliveryPromiseDailyBudget Int   @default(2000)
  deliveryPromiseServices  Json    @default("[\"AIRTIME\",\"DATA\"]")
  // Rewards split (lib/rewardSplit.js): give back a set % of what you
  // earn on each purchase, shared automatically between cashback,
  // loyalty points, the agent's shop commission, and pools that pay
  // referral bonuses, challenge rewards and delivery-promise bonuses.
  rewardSplitEnabled       Boolean @default(false)
  rewardSplitPct           Int     @default(30)
  rewardSplitShares        Json    @default("{\"CASHBACK\":35,\"LOYALTY\":20,\"REFERRAL\":20,\"CHALLENGES\":10,\"PROMISE\":5,\"SHOP\":10}")
  // Agent shop links (lib/shop.js): commission paid to the agent on
  // each purchase made through their link, capped per order and by the
  // reward safety limit.
  shopLinksEnabled         Boolean @default(false)
  shopCommissionPct        Decimal @default(1) @db.Decimal(5, 2)
  // Natural AI voice for chat replies (OpenAI text-to-speech).
  ttsEnabled             Boolean @default(false)
  ttsVoice               String  @default("coral")
  ttsMonthlyBudgetUsd    Decimal @default(3) @db.Decimal(10, 2)
  ttsDailyLimit          Int     @default(30)
  // AI background pictures for Ad Studio (OpenAI images).
  adImagesEnabled        Boolean @default(false)
  adImageQuality         String  @default("medium")
  adImageMonthlyBudgetUsd Decimal @default(5) @db.Decimal(10, 2)
  // Check name + date of birth against BVN/NIN before giving an account number.
  idMatchEnabled         Boolean @default(false)
  // International airtime/data shown to customers (needs VTpass live prices).
  intlAirtimeEnabled     Boolean @default(false)
  // Attack watch: block addresses that scan, guess passwords or forge logins.
  attackWatchEnabled     Boolean @default(true)
  problemSpotterEnabled  Boolean @default(true)
  monthlySummaryEnabled  Boolean @default(true)
  lastMonthlySummaryKey  String?
  agentWeeklyEnabled     Boolean @default(true)
  lastAgentWeeklyKey     String?
  shopCommissionMax        Int     @default(50)
  updatedAt              DateTime @updatedAt
}

// One row per AI assistant reply, for the daily per-customer cap and
// the monthly spend estimate. day is the Lagos date (YYYY-MM-DD).
model AiUsage {
  id           String   @id @default(cuid())
  actorType    String
  actorId      String
  day          String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  createdAt    DateTime @default(now())

  @@index([actorType, actorId, day])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorAdminId String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// A saved phone number / meter / smartcard / account ID, so customers
// tap instead of retyping (fewer wrong-number purchases).
model Beneficiary {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service     OrderService
  serviceID   String
  billersCode String
  meterType   String?
  nickname    String?
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime     @default(now())

  @@unique([customerId, service, serviceID, billersCode])
  @@index([customerId, lastUsedAt])
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// A purchase that repeats automatically (e.g. renew DStv monthly). It
// was PIN-confirmed when created; each run is a normal purchase from
// the wallet (lib/schedules.js). Paused after 3 failures in a row.
model ScheduledPurchase {
  id            String            @id @default(cuid())
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       OrderService
  serviceID     String
  variationCode String?
  meterType     String?
  billersCode   String
  phone         String
  // Base (VTpass) amount for amount-based services; null for plans,
  // whose current price is looked up at each run.
  amount        Decimal?          @db.Decimal(14, 2)
  frequency     ScheduleFrequency
  anchorDay     Int
  nickname      String?
  active        Boolean           @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  lastStatus    String?
  lastError     String?
  failCount     Int               @default(0)
  // The run we last sent a "top up before your renewal" reminder for.
  lowBalanceWarnedFor DateTime?
  createdAt     DateTime          @default(now())

  @@index([active, nextRunAt])
  @@index([customerId])
}

// A customer's transfer from their wallet to a bank account (Monnify
// disbursement). The wallet is debited (amount + fee) before Monnify is
// called; a FAILED / REVERSED / EXPIRED result refunds it exactly once.
// Status: PROCESSING | PENDING_AUTHORIZATION | SUCCESS | FAILED | REVERSED
model BankTransfer {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  amount         Decimal   @db.Decimal(14, 2)
  fee            Decimal   @default(0) @db.Decimal(14, 2)
  bankCode       String
  bankName       String?
  accountNumber  String
  accountName    String
  narration      String?
  reference      String    @unique
  status         String    @default("PROCESSING")
  providerStatus String?
  failureReason  String?
  refundedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

// Discount codes customers type at checkout, e.g. FIRST50.
// type PERCENT (value = %, capped by maxDiscount) or FLAT (value = ₦).
model PromoCode {
  id               String            @id @default(cuid())
  code             String            @unique
  description      String?
  // FLAT / PERCENT = discount at checkout. CREDIT = wallet gift coupon:
  // redeemed on the Wallet page, adds value ₦ to the wallet.
  type             String            @default("FLAT")
  value            Decimal           @db.Decimal(14, 2)
  maxDiscount      Decimal?          @db.Decimal(14, 2)
  minAmount        Decimal           @default(0) @db.Decimal(14, 2)
  services         String[]
  usageLimit       Int?
  perCustomerLimit Int               @default(1)
  usedCount        Int               @default(0)
  newCustomersOnly Boolean           @default(false)
  // Only customers in this group can use it (lib/audience.js).
  audience         String            @default("ALL")
  active           Boolean           @default(true)
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  redemptions      PromoRedemption[]
}

model PromoRedemption {
  id         String    @id @default(cuid())
  promoId    String
  promo      PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String    @unique
  discount   Decimal   @db.Decimal(14, 2)
  createdAt  DateTime  @default(now())

  @@index([promoId, customerId])
}

// Admin-posted notices, e.g. "MTN data is slow right now". service
// null = shown everywhere; level INFO or WARNING.
model ServiceNotice {
  id        String    @id @default(cuid())
  message   String
  service   String?
  level     String    @default("INFO")
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// A browser/phone that allowed push notifications.
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Push subscriptions for the admin app (separate from customers').
model AdminPushSubscription {
  id        String   @id @default(cuid())
  adminId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([adminId])
}

// "How was your purchase?" ratings.
model Feedback {
  id         String   @id @default(cuid())
  customerId String
  orderId    String?
  rating     Int
  comment    String?
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([customerId, createdAt])
}

// Referral contest. Only friends who SIGN UP during the contest count,
// and only once they make a purchase or bank transfer before it ends
// (contests can't overlap, so each new contest starts from zero).
// prizes: naira per rank, e.g. [10000, 5000, 2500]. status: ACTIVE,
// AWAITING_PAYOUT (ended, waiting for admin), PAYING, PAID, CANCELLED.
model ReferralContest {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  startsAt            DateTime
  endsAt              DateTime
  prizes              Json
  minReferrals        Int       @default(1)
  minQualifyingAmount Decimal   @default(0) @db.Decimal(14, 2)
  autoPay             Boolean   @default(false)
  // Friends must have verified their BVN/NIN (by getting a personal
  // account number) before the contest ends to count.
  requireVerified     Boolean   @default(true)
  status              String    @default("ACTIVE")
  disqualified        Json      @default("[]")
  winners             Json?
  paidAt              DateTime?
  createdAt           DateTime  @default(now())

  @@index([status, endsAt])
}

// In-app adverts / announcements with a picture (home screen slider
// and/or a one-time pop-up). image is a data: URI (compressed JPEG).
model AppAd {
  id         String    @id @default(cuid())
  title      String
  body       String?
  image      String?   @db.Text
  linkUrl    String?
  buttonText String?
  placement  String    @default("HOME")
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  sortOrder  Int       @default(0)
  clicks     Int       @default(0)
  // Times it was shown (once per app open), for tap rate.
  views      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  video      AdVideo?
}

// Optional short video for an advert (MP4/WebM, max ~10 MB). Only shown
// when Settings.videoAdsEnabled is on.
model AdVideo {
  adId      String   @id
  ad        AppAd    @relation(fields: [adId], references: [id], onDelete: Cascade)
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// Screenshots/photos a customer attaches to a support message (data:
// URI, compressed on the phone first). Kept separate so ticket lists
// stay light.
model TicketAttachment {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  image     String        @db.Text
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// Activity rewards (lib/challenges.js): "buy data 5 times this month,
// get ₦50", "spend ₦10,000 on electricity", "buy something 7 days in a
// row". Paid from earnings and limited by the giveaway safety limit —
// tied to purchases, never to how much sits in a wallet.
model Challenge {
  id          String        @id @default(cuid())
  title       String
  description String?
  kind        ChallengeKind
  // null = any service
  service     OrderService?
  // COUNT: number of purchases · SPEND: ₦ total · STREAK: days in a row
  target      Int
  // Each purchase must be at least this much to count.
  minAmount   Int           @default(0)
  reward      Decimal       @db.Decimal(14, 2)
  period      ChallengePeriod
  // For ONCE: the challenge window. For WEEKLY/MONTHLY: optional start
  // and end of the whole campaign.
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean       @default(true)
  // Most the challenge may pay out in total (null = no limit).
  budget      Decimal?      @db.Decimal(14, 2)
  paidTotal   Decimal       @default(0) @db.Decimal(14, 2)
  createdAt   DateTime      @default(now())
  rewards     ChallengeReward[]
}

enum ChallengeKind {
  COUNT
  SPEND
  STREAK
}

enum ChallengePeriod {
  WEEKLY
  MONTHLY
  ONCE
}

// One row per customer per challenge per period — the unique key is
// what stops a reward ever being paid twice.
model ChallengeReward {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  customerId  String
  periodKey   String
  amount      Decimal   @db.Decimal(14, 2)
  // Full reward before the safety limit trimmed it (if it did).
  fullAmount  Decimal   @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())

  @@unique([challengeId, customerId, periodKey])
  @@index([customerId, createdAt])
}

// One row per login (password, sign-up, PIN or fingerprint), so the
// customer can see where they're logged in and log other phones out.
model LoginSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  method     String
  // Trusted device used for PIN / fingerprint login: a new quick login
  // on the same phone replaces the old session instead of adding one.
  deviceId   String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([customerId, lastSeenAt])
}

// "Your DStv expires in 3 days" / "Your MTN 10GB plan ends tomorrow".
// Created after a successful cable or data purchase: cable due dates
// come from VTpass's smartcard check, data from the plan length.
model BillReminder {
  id              String       @id @default(cuid())
  customerId      String
  service         OrderService
  serviceID       String
  billersCode     String
  variationCode   String?
  label           String
  dueDate         DateTime
  // Due date we last reminded about, so each renewal is reminded once.
  lastRemindedFor DateTime?
  active          Boolean      @default(true)
  updatedAt       DateTime     @updatedAt
  createdAt       DateTime     @default(now())

  @@unique([customerId, service, serviceID, billersCode])
  @@index([active, dueDate])
}

// "Ridwan sent you ₦1,000 MTN airtime 🎁 Happy birthday!" — a shareable
// card for an airtime or data purchase made for someone else. The link
// (/gift/<token>) is public, so it shows only a first name, the message
// and the last 4 digits of the number.
model Gift {
  id         String    @id @default(cuid())
  token      String    @unique
  orderId    String    @unique
  customerId String
  fromName   String
  message    String?
  theme      String    @default("JUST_BECAUSE")
  viewCount  Int       @default(0)
  firstViewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

// Agent profit book: what an agent charged their own customer for a
// purchase (defaults to face value when not set), who it was for, and
// whether they still owe.
model AgentSale {
  id           String    @id @default(cuid())
  agentId      String
  orderId      String    @unique
  soldFor      Decimal   @db.Decimal(14, 2)
  customerName String?
  owing        Boolean   @default(false)
  paidAt       DateTime?
  note         String?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([agentId, owing])
}

// Family wallet: a parent links a family member's account (they must
// accept) to send an automatic allowance and set spending controls.
model FamilyLink {
  id                 String    @id @default(cuid())
  parentId           String
  childId            String    @unique
  nickname           String?
  status             String    @default("PENDING") // PENDING, ACTIVE, ENDED
  // Spending controls on the member's account (null = no limit / all).
  dailyLimit         Int?
  allowedServices    Json?
  allowSendMoney     Boolean   @default(false)
  // Automatic allowance from the parent's wallet.
  allowanceAmount    Int?
  allowanceFrequency String?   // WEEKLY, MONTHLY
  nextAllowanceAt    DateTime?
  lastAllowanceAt    DateTime?
  lastAllowanceError String?
  createdAt          DateTime  @default(now())
  acceptedAt         DateTime?
  endedAt            DateTime?

  @@index([parentId])
  @@index([status, nextAllowanceAt])
}

// Money set aside by the rewards split for rewards that aren't paid on
// the purchase itself (referral bonuses, challenges, delivery promise).
model RewardPool {
  key       String   @id
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt
}

// Every amount added to or paid out of a reward pool.
model RewardPoolMove {
  id        String   @id @default(cuid())
  pool      String
  amount    Decimal  @db.Decimal(14, 2)
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([pool, createdAt])
}

// A change the admin AI assistant proposed (lib/adminActions.js). Only
// applied when the owner taps Apply; `undo` puts the old values back.
model AdminAction {
  id        String    @id @default(cuid())
  adminId   String
  kind      String
  summary   String
  changes   Json
  requests  Json
  undo      Json?
  warnings  Json?
  ids       Json?
  status    String    @default("PENDING") // PENDING, APPLYING, APPLIED, UNDOING, UNDONE, DISMISSED, EXPIRED, FAILED
  error     String?
  createdAt DateTime  @default(now())
  appliedAt DateTime?

  @@index([adminId, createdAt])
}

// Last known VTpass price of each plan, to spot price changes.
model PriceSnapshot {
  id            String   @id @default(cuid())
  serviceID     String
  variationCode String
  name          String
  amount        Decimal  @db.Decimal(14, 2)
  previous      Decimal? @db.Decimal(14, 2)
  changedAt     DateTime?
  seenAt        DateTime @default(now())

  @@unique([serviceID, variationCode])
  @@index([changedAt])
}

// A fraud / abuse pattern already raised, so the owner is alerted once.
model RiskFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  severity  String
  title     String
  detail    String
  customerIds Json?
  status    String   @default("OPEN") // OPEN, DISMISSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Help Centre answers added from the admin (on top of the built-in ones).
model FaqEntry {
  id        String   @id @default(cuid())
  topic     String
  question  String
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Recharge card printing: one row per order of printable airtime PINs
// from ClubKonnect. amount is what left the wallet; cards are stored
// once delivered. Settles exactly once (PENDING → SUCCESS / FAILED).
model PinBatch {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  network         String
  value           Int
  quantity        Int
  delivered       Int         @default(0)
  unitPrice       Decimal     @db.Decimal(14, 2)
  amount          Decimal     @db.Decimal(14, 2)
  refunded        Decimal     @default(0) @db.Decimal(14, 2)
  costAmount      Decimal?    @db.Decimal(14, 2)
  requestId       String      @unique
  providerOrderId String?
  providerStatus  String?
  status          OrderStatus @default(PENDING)
  businessName    String?
  checks          Int         @default(0)
  printedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cards           PinCard[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model PinCard {
  id        String    @id @default(cuid())
  batchId   String
  batch     PinBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pin       String
  serial    String?
  batchNo   String?
  soldAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([batchId, pin])
  @@index([batchId])
}

// A HeyGen presenter video made from the admin (Ad Studio or AI chat).
model AiVideo {
  id            String    @id @default(cuid())
  adminId       String
  title         String
  script        String    @db.Text
  avatarId      String
  voiceId       String
  aspect        String    @default("9:16")
  heygenVideoId String?
  status        String    @default("PENDING")
  videoUrl      String?   @db.Text
  thumbnailUrl  String?   @db.Text
  duration      Float?
  estUsd        Decimal   @default(0) @db.Decimal(8, 2)
  costUsd       Decimal?  @db.Decimal(8, 2)
  error         String?
  urlExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
}

// Scam messages customers reported through the help chat.
model ScamReport {
  id         String   @id @default(cuid())
  customerId String
  summary    String   @db.Text
  channel    String
  contact    String?
  lostMoney  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Each BVN/NIN name + date-of-birth check (no ID numbers stored).
model IdCheck {
  id         String   @id @default(cuid())
  customerId String
  idType     String
  result     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// Attack watch (lib/attackWatch.js): warning signs seen by the server.
// Kept 30 days.
model SecurityEvent {
  id         String   @id @default(cuid())
  kind       String
  ip         String?
  path       String?
  detail     String?
  customerId String?
  adminId    String?
  count      Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

// Internet addresses blocked for a while (automatically or by the owner).
// scope ALL = the whole API, ADMIN = admin login and admin pages only.
model IpBlock {
  id        String    @id @default(cuid())
  ip        String
  scope     String    @default("ALL")
  reason    String
  auto      Boolean   @default(true)
  until     DateTime
  liftedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([ip, until])
}

// "Pay me" links, split bills and group gifts (lib/payRequests.js).
// Money always moves wallet to wallet, straight to the owner — nothing
// is held by ZAPPI PAY in between.
// kind: REQUEST (one payment), SPLIT (one share per person), POOL (group
// gift / contribution, any amount). status: OPEN, DONE, CLOSED, CANCELLED.
model MoneyRequest {
  id         String    @id @default(cuid())
  token      String    @unique
  kind       String
  ownerId    String
  title      String
  note       String?
  amount     Decimal?  @db.Decimal(14, 2)
  total      Decimal?  @db.Decimal(14, 2)
  target     Decimal?  @db.Decimal(14, 2)
  slots      Int?
  collected  Decimal   @default(0) @db.Decimal(14, 2)
  payments   Int       @default(0)
  invited    Json?
  status     String    @default("OPEN")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([ownerId, createdAt])
}

model MoneyRequestPayment {
  id         String   @id @default(cuid())
  requestId  String
  payerId    String
  slotKey    String
  amount     Decimal  @db.Decimal(14, 2)
  message    String?
  hideAmount Boolean  @default(false)
  transferId String?
  createdAt  DateTime @default(now())

  @@unique([requestId, slotKey])
  @@index([payerId, createdAt])
}
